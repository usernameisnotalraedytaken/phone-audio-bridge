# 构建产物
build/
.gradle/
*.iml
local.properties
app/build/

# 编译产物（源码可重建：build.ps1 / make-icon.ps1）
pc-receiver/*.exe
pc-receiver/*.ico

# 运行期生成与日志
*.log
receiver.log
phone.log
gui-startup.log
recv*.txt
probe-http-hits.txt
pc-receiver/receiver.cfg

# 调试与探测残留
pc-receiver/_vmprobe/
pc-receiver/*.corrupt-backup
pc-receiver/*.head-clean.cs
pc-receiver/shot-gui.ps1

# 系统
.DS_Store
Thumbs.db

# 预共享密钥（构建时注入，绝不入库）
.snad-key

# 构建期由 build.ps1 从 .snad-key 生成，内含真实密钥，绝不入库
pc-receiver/SnadSecret.cs

# 注意：app/.../SnadSecret.kt 是空密钥占位版，必须入库否则编译失败，
# CI 会在构建时覆盖它（覆盖发生在工作区，不影响仓库内容）。

# 基线存档目录含预共享密钥，绝不入库
../SNAD-baseline-v*/
SNAD-baseline-v*/
